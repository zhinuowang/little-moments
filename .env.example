# Copy to .env.local (git-ignored) to turn on cloud sync in local development.
# Both values are PUBLIC: the project URL and the *publishable* (anon) key.
# NEVER put the secret / service_role key here, in GitHub, or anywhere in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# 'open' only after a verified sending domain has been tested with real inboxes
VITE_EMAIL_SIGNIN=limited
